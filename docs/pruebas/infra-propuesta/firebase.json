{
  "_borrador": "BORRADOR de GymTrack. Al activarlo: copia este archivo a la raíz del repo, copia storage.rules a infra/firebase/storage.rules, copia firebaserc.ejemplo a .firebaserc con los ids reales y borra esta clave _borrador. Hosting sirve solo docs/pantallas; Storage niega todo acceso directo desde el cliente.",
  "hosting": [
    {
      "target": "maquetas",
      "public": "docs/pantallas",
      "ignore": ["**/.*", "**/*.md", "**/node_modules/**"],
      "cleanUrls": false,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "no-referrer" }
          ]
        },
        {
          "source": "**/*.@(css|js|svg|html)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
        }
      ]
    }
  ],
  "storage": {
    "rules": "infra/firebase/storage.rules"
  },
  "emulators": {
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
