# ─────────────────────────────────────────────────────────────────────────────
# Archivos de variables del VPS · BORRADOR, solo nombres y formato
#
# Ningún valor real va en el repo. Cada bloque es un archivo distinto en el
# servidor; los valores entre <> los pones tú al instalar. Dueño root, grupo
# despliegue, permisos 640 (los de /etc/gymtrack, 600 y solo root).
# ─────────────────────────────────────────────────────────────────────────────

# ── /opt/gymtrack/vps.env  (lo leen desplegar.sh y los timers)
DOMINIO=<dominio>
IMAGEN=ghcr.io/<dueño-en-minúsculas>/gymtrack-api

# ── /opt/gymtrack/borde/.env  (compose.borde.yml)
DOMINIO=<dominio>
CORREO_ACME=<correo-del-equipo>

# ── /opt/gymtrack/produccion/db.env  (y lo mismo en staging/db.env con otra clave)
POSTGRES_USER=gymtrack
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=gymtrack

# ── /opt/gymtrack/produccion/app.env  (y staging/app.env con sus propios valores)
NODE_ENV=production
PORT=3000
# Misma clave que db.env. connection_limit bajo: son 2 vCPU y max_connections=30.
DATABASE_URL=postgresql://gymtrack:<clave-de-db.env>@db:5432/gymtrack?connection_limit=5
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
# Correo por Resend (HTTPS), nunca SMTP directo desde el VPS.
RESEND_API_KEY=<re_...>
CORREO_REMITENTE=GymTrack <hola@<dominio>>
# Expo Push con «push security» activado en Expo.
EXPO_ACCESS_TOKEN=<token-de-robot-de-expo>
SENTRY_DSN=<dsn-del-proyecto-api>
SENTRY_ENVIRONMENT=produccion
# Cloud Storage para Firebase. La llave va montada como archivo (ver override).
FIREBASE_PROJECT_ID=<proyecto-produccion>
STORAGE_BUCKET=<bucket-de-medios-produccion>
URL_FIRMADA_MINUTOS=15
# Umbrales de detección (P-34), con los valores por defecto del PRD.
DETECCION_SESIONES_ESTANCAMIENTO=3
DETECCION_BAJA_PORCENTAJE=10
DETECCION_DIAS_SIN_SESIONES=7
DETECCION_INTENSIDAD_DOLOR=7
# Latido opcional del worker nocturno a Healthchecks.io.
HC_WORKER_URL=<https://hc-ping.com/...>

# ── /opt/gymtrack/<entorno>/secretos/storage-api.json
# Llave JSON de la cuenta de servicio «api-medios» de ese proyecto (permisos 640).

# ── /etc/gymtrack/respaldo/respaldo.env
BUCKET_RESPALDOS=<proyecto-produccion>-respaldos
HC_RESPALDO_URL=<https://hc-ping.com/...>
MINIMO_BYTES=20000

# ── /etc/gymtrack/respaldo/rclone.conf
# [gcs]
# type = google cloud storage
# service_account_file = /etc/gymtrack/respaldo/sa-respaldos.json
# bucket_policy_only = true
# location = southamerica-west1

# ── /etc/gymtrack/respaldo/age-destinatario.txt
# age1...   (solo la llave pública; la privada no entra nunca al servidor)

# ── /etc/gymtrack/vigilancia.env
HC_RECURSOS_URL=<https://hc-ping.com/...>
UMBRAL_DISCO=80
UMBRAL_RAM=90
UMBRAL_SWAP=50
