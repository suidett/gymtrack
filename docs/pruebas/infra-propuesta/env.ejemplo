# ─────────────────────────────────────────────────────────────────────────────
# Archivos de variables del VPS · BORRADOR, solo nombres y formato
#
# Ningún valor real va en el repo. Cada bloque es un archivo distinto en el
# servidor; los valores entre <> los pones tú al instalar. Dueño root, grupo
# despliegue, permisos 640 (los de /etc/gymtrack, 600 y solo root).
# ─────────────────────────────────────────────────────────────────────────────

# ── /opt/gymtrack/vps.env  (lo leen desplegar.sh y los timers)
DOMINIO=<dominio>
IMAGEN=ghcr.io/<dueño-en-minúsculas>/gymtrack-api

# ── /opt/gymtrack/borde/.env  (compose.borde.yml)
DOMINIO=<dominio>
CORREO_ACME=<correo-del-equipo>

# ── /opt/gymtrack/produccion/db.env  (y lo mismo en staging/db.env con otra clave)
POSTGRES_USER=gymtrack
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=gymtrack

# ── /opt/gymtrack/produccion/app.env  (y staging/app.env con sus propios valores)
# Las que lee la API hoy (apps/api/src/config.ts y apps/api/.env.ejemplo).
# VERSION y COMMIT_SHA NO van aquí: VERSION la pone compose (desplegar.sh) y
# COMMIT_SHA viene dentro de la imagen; si las pusieras, /health mentiría.
# RELOJ_FIJO tampoco: con NODE_ENV=production la API no arranca si viene (SEG-032).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Misma clave que db.env. El pool lo abre @prisma/adapter-pg (pg); connection_limit
# era del motor antiguo de Prisma y aquí no aplica.
DATABASE_URL=postgresql://gymtrack:<clave-de-db.env>@db:5432/gymtrack
# HS256 de los access de 15 minutos; obligatorio en producción, al menos 32 caracteres.
# Los refresh tokens son opacos y se guardan en la base: no hay otro secreto JWT.
JWT_SECRET=<openssl rand -hex 32>
# Detrás de Caddy: 1 salto. La API usa la IP que agregó Caddy en X-Forwarded-For
# para el límite de ingresos por IP. Con NODE_ENV=production el valor por defecto
# ya es 1, pero se deja escrito para que nadie lo apague sin querer.
CONFIAR_PROXY=1
# Correo por Resend (HTTPS), nunca SMTP directo desde el VPS. En producción la API
# exige resend.
CORREO_DRIVER=resend
RESEND_API_KEY=<re_...>
CORREO_REMITENTE=GymTrack <hola@<dominio>>
CORREO_RESPONDER_A=
# Base del enlace del correo de recuperación; la API agrega ?token=...
ENLACE_RESTABLECER_URL=gymtrack://restablecer

# PENDIENTE: la API todavía no lee estas. Se descomentan cuando llegue el código que
# las usa (push, Sentry, Storage, detección y worker) y se agregan a config.ts.
# EXPO_ACCESS_TOKEN=<token-de-robot-de-expo>     Expo Push con «push security»
# SENTRY_DSN=<dsn-del-proyecto-api>
# SENTRY_ENVIRONMENT=produccion
# FIREBASE_PROJECT_ID=<proyecto-produccion>      en staging: gymtrack-5dd46
# STORAGE_BUCKET=<bucket-de-medios-produccion>
# URL_FIRMADA_MINUTOS=15
# DETECCION_SESIONES_ESTANCAMIENTO=3             umbrales de detección (P-34)
# DETECCION_BAJA_PORCENTAJE=10
# DETECCION_DIAS_SIN_SESIONES=7
# DETECCION_INTENSIDAD_DOLOR=7
# HC_WORKER_URL=<https://hc-ping.com/...>        latido opcional del worker nocturno

# ── /opt/gymtrack/<entorno>/secretos/storage-api.json  (cuando la API use Storage)
# Llave JSON de la cuenta de servicio «api-medios» de ese proyecto. El contenedor
# corre como «node» (uid y gid 1000): dueño root, grupo 1000, permisos 640
#   chown root:1000 storage-api.json && chmod 640 storage-api.json
# Con root:despliegue el usuario node no la puede leer. El montaje está comentado
# en compose.staging.yml y compose.produccion.yml hasta entonces.

# ── /etc/gymtrack/respaldo/respaldo.env
BUCKET_RESPALDOS=<proyecto-produccion>-respaldos
HC_RESPALDO_URL=<https://hc-ping.com/...>
MINIMO_BYTES=20000

# ── /etc/gymtrack/respaldo/rclone.conf
# [gcs]
# type = google cloud storage
# service_account_file = /etc/gymtrack/respaldo/sa-respaldos.json
# bucket_policy_only = true
# location = southamerica-west1

# ── /etc/gymtrack/respaldo/age-destinatario.txt
# age1...   (solo la llave pública; la privada no entra nunca al servidor)

# ── /etc/gymtrack/vigilancia.env
HC_RECURSOS_URL=<https://hc-ping.com/...>
UMBRAL_DISCO=80
UMBRAL_RAM=90
UMBRAL_SWAP=50
