# ─────────────────────────────────────────────────────────────────────────────
# Variables de la API · ejemplo para local (copia a apps/api/.env, que no se commitea)
#
# Ningún valor de aquí es un secreto real. En staging y producción las variables viven en
# /opt/gymtrack/<entorno>/app.env del VPS (docs/pruebas/infra-propuesta/env.ejemplo).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 de compose.dev.yml (pnpm --filter api db:levantar). Las pruebas usan gymtrack_test.
DATABASE_URL=postgresql://gymtrack:gymtrack@127.0.0.1:5442/gymtrack

# HS256 del access de 15 minutos. Genera uno con: openssl rand -hex 32
# En local puedes dejarlo vacío: la API inventa uno al arrancar (los tokens mueren al reiniciar).
# En producción es obligatorio, y el worker tiene que usar el mismo (de él sale la llave que
# cifra los dispositivos de los avisos).
JWT_SECRET=

# Lo que devuelve /health. En el VPS los fija compose (VERSION) y el Dockerfile (COMMIT_SHA).
VERSION=dev
COMMIT_SHA=local

# true detrás de Caddy, para que el límite de ingresos por IP use la IP real.
CONFIAR_PROXY=false

# Correo: resend o smtp (staging y producción) | consola (local) | memoria (pruebas).
# Por defecto: production → resend, test → memoria, development → consola.
CORREO_DRIVER=consola
# Solo con CORREO_DRIVER=resend. Clave de prueba o de producción de Resend, nunca en el repo.
RESEND_API_KEY=
# Solo con CORREO_DRIVER=smtp (Gmail con clave de aplicación, ver el README de la API).
# SMTP_USUARIO es la cuenta de Gmail; SMTP_CLAVE, la clave de aplicación de 16 letras que da
# Google (se aceptan los espacios), nunca la contraseña de la cuenta. Puerto 465 (TLS) o 587.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
# Remitente: con Resend, de un dominio verificado; con Gmail, la misma cuenta (si lo dejas sin
# la línea, con smtp se usa «GymTrack <SMTP_USUARIO>»).
CORREO_REMITENTE=GymTrack <hola@gymtrack.test>
CORREO_RESPONDER_A=
# Con el driver consola, escribe cada correo completo (con su enlace) en esta carpeta.
CORREO_CARPETA=tmp/correos

# Base del enlace de recuperación; la API agrega ?token=... En el VPS conviene la app web
# (https://gymtrack-app-5dd46.web.app/restablecer): abre en el iPhone, que no tiene app nativa,
# y en cualquier Android. gymtrack://restablecer solo abre el APK instalado.
ENLACE_RESTABLECER_URL=gymtrack://restablecer

# Solo en pruebas o local: la API arranca con este «ahora». Prohibido en producción (SEG-032).
# RELOJ_FIJO=2026-11-17T13:00:00Z

# Orígenes web que pueden llamar desde un navegador, separados por coma, como esquema://dominio
# sin ruta. En el VPS va el de la app web para iPhone: https://gymtrack-app-5dd46.web.app
# Vacío fuera de producción: se acepta http://localhost:* y http://127.0.0.1:* (Expo web).
# Con un valor puesto, localhost deja de tener permiso. Un origen mal escrito (comodín, ruta,
# http en producción) no deja arrancar la API.
CORS_ORIGENES=

# Ingreso con Google (POST /v1/auth/google): los client ID de OAuth de la app web y del APK,
# separados por coma, sin espacios ni comillas (docs/CONFIGURAR-SERVICIOS.md, paso 1). No son
# secretos. Vacío: el ingreso con Google responde 503 y el resto de la API funciona igual. Un
# valor sin la forma <número>-<código>.apps.googleusercontent.com no deja arrancar la API.
GOOGLE_CLIENT_IDS=

# Fotos de progreso: hoy solo «disco». En Docker, ALMACENAMIENTO_DIR tiene que ser un volumen.
ALMACENAMIENTO_DRIVER=disco
ALMACENAMIENTO_DIR=tmp/almacenamiento

# Umbrales de las alertas (P-34). Estos son los valores del PRD.
UMBRAL_ESTANCAMIENTO_SESIONES=3
UMBRAL_BAJA_PCT=10
UMBRAL_BAJA_SEMANAS=4
UMBRAL_BAJA_SEMANAS_MIN=2
UMBRAL_SIN_SESIONES_DIAS=7
UMBRAL_DOLOR_INTENSIDAD=7

# Avisos al celular (src/modulos/notificaciones). PUSH_DRIVER: real (Expo y Web Push) | consola
# (solo log) | memoria (pruebas). Por defecto: production → real, test → memoria, development → consola.
PUSH_DRIVER=
# Llaves de Web Push para la app web del iPhone: las tres o ninguna. Genéralas una vez con
#   npx web-push generate-vapid-keys
# La pública va también en la app como EXPO_PUBLIC_VAPID_PUBLICA. VAPID_CONTACTO: mailto:correo
# o una dirección https (Apple rechaza localhost). La privada nunca va en el repo ni en la app.
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=
# Solo si activas «Enhanced push security» en expo.dev (Access tokens). Sin eso, vacío.
EXPO_ACCESS_TOKEN=
# Dirección de la app web, para el botón «Abrir Alertas» de los correos. Vacío: sin botón.
AVISOS_URL_APP=
