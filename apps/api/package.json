{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API de GymTrack: Fastify 5, Zod y Prisma sobre PostgreSQL 16. Cuentas, sesiones y correos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && node --env-file-if-exists=.env --import tsx --watch src/servidor.ts",
    "build": "prisma generate && node scripts/construir.mjs",
    "start": "node dist/servidor.js",
    "worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "prisma generate && vitest run",
    "test:int": "sh scripts/pruebas-con-base.sh",
    "db:levantar": "docker compose -f compose.dev.yml up -d --wait db",
    "db:bajar": "docker compose -f compose.dev.yml down",
    "db:migrar": "prisma migrate deploy",
    "db:nueva-migracion": "prisma migrate dev"
  },
  "dependencies": {
    "@gymtrack/shared": "workspace:*",
    "@gymtrack/tokens": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.17",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "pino": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.1"
  }
}
