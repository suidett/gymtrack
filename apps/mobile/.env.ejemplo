# Copia este archivo como .env.local (no se commitea) y ajusta los valores. Todos son públicos:
# Expo los pega en el código de la app al empaquetar (EXPO_PUBLIC_*), así que aquí nunca va un secreto.

# Dirección de la API. En el emulador de Android, localhost es el emulador: usa 10.0.2.2. En un
# teléfono con Expo Go, la IP de tu computador en la misma red wifi. El APK de EAS usa la del VPS
# (eas.json) y export:web también (package.json).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Ingreso con Google (docs/CONFIGURAR-SERVICIOS.md, paso 1). Sin valor, el botón «Continuar con
# Google» no aparece. El de web sirve para la app web y para Expo web en localhost:8081; el de
# Android solo funciona en el APK (en Expo Go Google no acepta la vuelta exp://).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Avisos en la app web del iPhone: la llave pública VAPID, la misma VAPID_PUBLICA de la API.
# Sin valor, Perfil dice que este navegador no recibe avisos. La privada nunca va aquí.
EXPO_PUBLIC_VAPID_PUBLICA=
