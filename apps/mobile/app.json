{
  "expo": {
    "name": "GymTrack",
    "slug": "gymtrack",
    "version": "0.1.0",
    "scheme": [
      "gymtrack",
      "com.gymtrack.app"
    ],
    "orientation": "portrait",
    "icon": "./assets/marca/icono.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0F1113",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymtrack.app"
    },
    "android": {
      "package": "com.gymtrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1D20",
        "foregroundImage": "./assets/marca/android-primer-plano.png",
        "backgroundImage": "./assets/marca/android-fondo.png",
        "monochromeImage": "./assets/marca/android-monocromo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/marca/favicon.png",
      "name": "GymTrack",
      "lang": "es-CL",
      "description": "Arma, sigue y ajusta tus rutinas con tu entrenador.",
      "themeColor": "#0F1113"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/marca/splash.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#0F1113"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/marca/notificacion.png",
          "color": "#F5B83D",
          "defaultChannel": "avisos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "027de01a-4f6d-4e59-9e87-052058cb5371"
      },
      "urlTerminos": "https://gymtrack-app-5dd46.web.app/terminos.html",
      "urlPrivacidad": "https://gymtrack-app-5dd46.web.app/privacidad.html"
    },
    "owner": "suidett2"
  }
}
