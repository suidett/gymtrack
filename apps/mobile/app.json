{
  "expo": {
    "name": "GymTrack",
    "slug": "gymtrack",
    "version": "0.1.0",
    "scheme": "gymtrack",
    "orientation": "portrait",
    "icon": "./assets/marca/icono.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0F1113",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymtrack.app"
    },
    "android": {
      "package": "com.gymtrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1D20",
        "foregroundImage": "./assets/marca/android-primer-plano.png",
        "backgroundImage": "./assets/marca/android-fondo.png",
        "monochromeImage": "./assets/marca/android-monocromo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/marca/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/marca/splash.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#0F1113"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
